# ============================================================
# Tempest server configuration
# ============================================================
# Copy to server/.env and fill in. NEVER commit the real file.
#   cp server/.env.example server/.env
#
# Real environment variables override anything set here, so a systemd
# drop-in or a one-off `export` always wins.

# --- where it listens ---------------------------------------------------
# PORT is only used when TLS is OFF (see below). With TLS on, the ports are
# HTTPS_PORT and HTTP_PORT instead.
PORT=8791

# Which interface to listen on.
#   0.0.0.0    every interface - what you want when Tempest faces the internet,
#              which it does whenever TLS is configured below.
#   127.0.0.1  loopback only - correct ONLY if something else on this box is
#              proxying to it.
#
# Getting this wrong is quiet: on 127.0.0.1 the site answers perfectly from the
# box itself and is unreachable from everywhere else, so the first symptom is
# Let's Encrypt failing with "connection refused".
HOST=0.0.0.0

# Where recordings, flags, accounts and brackets are kept. Relative paths are
# resolved against server/. Back this directory up; that is the whole backup.
DATA_DIR=data

# --- TLS -----------------------------------------------------------------
# Set both and Tempest serves HTTPS itself on 443, with 80 redirecting to it
# and answering ACME challenges. No reverse proxy, nothing else on the box to
# configure, one service to restart.
#
# Leave BOTH blank if something else really is terminating TLS in front of you;
# then it stays plain HTTP on PORT above, bound to loopback.
#
# These point at the copies the certbot deploy hook makes, NOT at
# /etc/letsencrypt directly - the key there is root-only and this does not run
# as root. See server/certbot-deploy-hook.sh.
TLS_CERT=/opt/tempest/server/tls/fullchain.pem
TLS_KEY=/opt/tempest/server/tls/privkey.pem

# The ACME webroot: exactly what you pass to `certbot --webroot -w`. Certbot
# appends .well-known/acme-challenge/ itself.
ACME_DIR=/opt/tempest/server/acme

# Only change these if something else on the box owns 80 or 443.
HTTPS_PORT=443
HTTP_PORT=80

# --- secrets ------------------------------------------------------------
# Must match Perspective's web.ingest-key and TempestAC's web.key. Lets the
# holder WRITE recordings and flags, so it is server-side only - it must never
# appear in management.js or anywhere else the browser can read.
#   openssl rand -hex 32
INGEST_KEY=

# Signs session tokens. Changing it logs everyone out, which is the panic
# button if a token ever leaks.
#   openssl rand -hex 32
SESSION_SECRET=

# Bootstrap staff, so there is somebody to log in as. Same shape as the
# window.TEMPEST_STAFF block in staff.js - use "Copy server staff" on the
# Staff tab to generate it. Must be one line.
# Re-applied whenever this value CHANGES, which is the way back in if every
# owner gets locked out. Normal staff changes go through the Staff tab.
STAFF_JSON=[]

# --- role levels --------------------------------------------------------
# Level needed to READ management data (recordings, flags, cases). 3 is Mod.
MIN_READ_LEVEL=3
# Level needed to manage accounts and the capability ladder. 6 is Owner.
MIN_MANAGE_LEVEL=6

# --- limits -------------------------------------------------------------
# Largest recording body kept whole. Cloudflare forced 118 KiB because a
# Durable Object value caps at 128 KiB; there is no such limit here, so this
# can go up and transcripts stop being truncated. 2 MiB holds a long session.
MAX_RECORD_BYTES=2097152

# Hard stop on any request body, before the above applies.
MAX_BODY_BYTES=16777216
