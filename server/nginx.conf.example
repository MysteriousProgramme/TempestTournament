# ============================================================
# Tempest — nginx, in front of the Node service
# ============================================================
# nginx does exactly one job here: terminate TLS. Node serves both the site
# and the API, so there is a single upstream and nothing to route.
#
#   sudo cp server/nginx.conf.example /etc/nginx/conf.d/tempest.conf
#   sudo nginx -t && sudo systemctl enable --now nginx
#   sudo certbot --nginx -d 43-210-250-181.sslip.io --agree-tos --redirect -m <your-email>
#
# ------------------------------------------------------------------
# There is deliberately only ONE server block, and it is on port 80.
# ------------------------------------------------------------------
# certbot --nginx finds the block whose server_name matches, adds the
# listen 443 and ssl_certificate lines to it, and writes a second block
# that redirects port 80 to it.
#
# Shipping a ready-made 443 block with the certificate lines commented
# out does NOT work: nginx rejects `listen ... ssl` with no
# ssl_certificate, so `nginx -t` fails before certbot ever gets to run.
#
# So run this as-is, let certbot rewrite it, and do not hand-edit the
# lines it adds - it has to recognise them again at renewal.
#
# ------------------------------------------------------------------
# server_name CANNOT be a bare IP, and cannot be the EC2 hostname.
# ------------------------------------------------------------------
# Logging in derives a PBKDF2 hash with WebCrypto, and browsers only
# expose crypto.subtle in a secure context. Over plain http:// at a
# public address there is no crypto.subtle, so the site loads and the
# login silently refuses. HTTPS is required, so a name is required.
#
# 43-210-250-181.sslip.io is this instance's Elastic IP with dashes.
# sslip.io resolves it straight back to 43.210.250.181, so there is no
# DNS to configure and nothing to buy. If the Elastic IP ever changes,
# this name changes with it and so does everything below.
#
# Not the EC2 name: Let's Encrypt blocks amazonaws.com hostnames at
# AWS's request, so certbot fails on it.
# ==================================================================

server {
    listen 80;
    listen [::]:80;

    # this instance's Elastic IP, via sslip.io
    server_name 43-210-250-181.sslip.io;

    # A Perspective recording with a full transcript is the largest thing that
    # crosses this proxy. nginx defaults to 1m, which rejects them with a 413
    # that looks, from the game server, exactly like the site being down. Keep
    # this comfortably above MAX_RECORD_BYTES in server/.env.
    client_max_body_size 20m;

    # The plugin polls and the site long-reads; neither should be cut off.
    proxy_read_timeout 120s;

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Belt and braces. The Node server already refuses these paths, but if it
    # is ever swapped for something that serves the directory naively, this is
    # what keeps .env and the data directory off the internet.
    location ~ ^/(server|relay|data|\.git)/ { return 404; }

    gzip on;
    gzip_types text/css text/javascript application/javascript application/json image/svg+xml;
    gzip_min_length 1024;
}
