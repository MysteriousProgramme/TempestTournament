# ============================================================
# Tempest — nginx, in front of the Node service
# ============================================================
# nginx does exactly one job here: terminate TLS. Node serves both the site
# and the API, so there is a single upstream and nothing to route.
#
#   sudo cp server/nginx.conf.example /etc/nginx/conf.d/tempest.conf
#   sudo $EDITOR /etc/nginx/conf.d/tempest.conf     # set your domain
#   sudo nginx -t && sudo systemctl reload nginx
#
# Then get a certificate:
#   sudo certbot --nginx -d tempest.example.com
# certbot rewrites this file with the ssl_* lines and the port 80 redirect.
#
# ------------------------------------------------------------------
# server_name CANNOT be a bare IP, and cannot be the EC2 hostname.
# ------------------------------------------------------------------
# Logging in derives a PBKDF2 hash with WebCrypto, and browsers only
# expose crypto.subtle in a secure context. Over plain http:// at a
# public address there is no crypto.subtle, so the site loads and the
# login silently refuses. HTTPS is required, so a name is required.
#
# Use an Elastic IP either way - the ordinary public IP changes when
# the instance stops, which breaks the plugins and every share link.
#
# Then one of:
#   - a domain you own, A record pointed at the Elastic IP; or
#   - <ip>.sslip.io, a free wildcard DNS service that resolves straight
#     to your IP with no signup. Elastic IP 203.0.113.42 becomes
#     203-0-113-42.sslip.io and certbot issues for it normally.
#
# Not the EC2 name: Let's Encrypt blocks amazonaws.com hostnames at
# AWS's request, so certbot fails on it.
# ==================================================================

server {
    listen 80;
    listen [::]:80;
    # your domain, or <ip>.sslip.io
    server_name tempest.example.com;

    # certbot writes its challenge here on renewal
    location /.well-known/acme-challenge/ { root /var/www/html; }

    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name tempest.example.com;

    # certbot fills these in
    # ssl_certificate     /etc/letsencrypt/live/tempest.example.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/tempest.example.com/privkey.pem;

    # A Perspective recording with a full transcript is the largest thing that
    # crosses this proxy. nginx defaults to 1m, which rejects them with a 413
    # that looks, from the game server, exactly like the site being down. Keep
    # this comfortably above MAX_RECORD_BYTES in server/.env.
    client_max_body_size 20m;

    # The plugin polls and the site long-reads; neither should be cut off.
    proxy_read_timeout 120s;

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Belt and braces. The Node server already refuses these paths, but if it
    # is ever swapped for something that serves the directory naively, this is
    # what keeps .env and the data directory off the internet.
    location ~ ^/(server|relay|data|\.git)/ { return 404; }

    gzip on;
    gzip_types text/css text/javascript application/javascript application/json image/svg+xml;
    gzip_min_length 1024;
}
