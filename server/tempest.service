# ============================================================
# Tempest — systemd unit
# ============================================================
# Install:
#   sudo cp server/tempest.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now tempest
# Watch it:
#   sudo systemctl status tempest
#   sudo journalctl -u tempest -f
#
# Adjust User, WorkingDirectory and ExecStart if you did not put the
# checkout at /opt/tempest or the service user is not `tempest`.

[Unit]
Description=Tempest site and management API
Documentation=file:///opt/tempest/server/README.md
# network-online rather than network: binding before the interface is up
# fails the start and burns a restart for nothing
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tempest
Group=tempest
WorkingDirectory=/opt/tempest
ExecStart=/usr/bin/node server/server.js
Environment=NODE_ENV=production

# A crash must not take the site down until somebody notices. StartLimit is
# deliberately generous: a bad .env should keep retrying and keep logging
# rather than give up quietly after five tries.
Restart=always
RestartSec=3
StartLimitIntervalSec=0

# In-flight requests get a moment to finish; the process handles SIGTERM.
KillSignal=SIGTERM
TimeoutStopSec=15

# --- hardening ---
# This process holds INGEST_KEY, SESSION_SECRET and every staff password
# hash, and it is reachable from the internet. It should be able to touch
# almost nothing on the box.
NoNewPrivileges=true

# Binding 443 and 80 as a non-root user needs exactly this one capability, and
# nothing else. Without it the service dies with EACCES on listen; with it,
# running as root is unnecessary.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true

# NOT MemoryDenyWriteExecute=true. It forbids memory that is both writable and
# executable, which is precisely what V8's JIT allocates - Node dies on start
# with SIGTRAP and a core dump. Correct for a C daemon, fatal for a JIT runtime.

# AF_NETLINK is in the list because glibc's getaddrinfo uses it to enumerate
# interfaces; without it name resolution can fail in ways that look like a
# network outage.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# ProtectSystem=strict makes everything read-only, so name the one directory
# that must not be. If you moved DATA_DIR, change this to match.
#
# The leading "-" means "do not fail the unit if it is missing". It still has
# to exist for the service to be able to write, and it is gitignored so a fresh
# clone does not have it - create it once:
#   sudo -u tempest mkdir -p /opt/tempest/server/data
# Without that, the process starts and serves, then fails on the first write
# with EROFS, which is a confusing way to find out.
ReadWritePaths=-/opt/tempest/server/data

# Logs go to the journal.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tempest

[Install]
WantedBy=multi-user.target
